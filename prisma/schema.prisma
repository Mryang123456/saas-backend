generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  TENANT_ADMIN
  EMPLOYEE
  DEPT_MANAGER
  FINANCE
  TENANT_OWNER
  AUDITOR
}

enum ApplicationStatus {
  DRAFT
  PENDING_DEPT_MANAGER
  PENDING_FINANCE
  PENDING_TENANT_OWNER
  APPROVED
  REJECTED
}

enum ApprovalNode {
  DEPT_MANAGER
  FINANCE
  TENANT_OWNER
}

enum ApprovalAction {
  APPROVE
  REJECT
}

enum AuditResult {
  SUCCESS
  FAILURE
}

model Tenant {
  id           String                @id @default(uuid()) @db.Char(36)
  slug         String                @unique @db.VarChar(64)
  name         String                @db.VarChar(100)
  timezone     String                @default("Asia/Shanghai") @db.VarChar(64)
  status       EntityStatus          @default(ACTIVE)
  createdAt    DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  departments  Department[]
  users        User[]
  applications PurchaseApplication[]

  @@map("tenants")
}

model Department {
  id            String                @id @default(uuid()) @db.Char(36)
  tenantId      String                @map("tenant_id") @db.Char(36)
  name          String                @db.VarChar(100)
  status        EntityStatus          @default(ACTIVE)
  managerUserId String?               @map("manager_user_id") @db.Char(36)
  version       Int                   @default(1)
  createdAt     DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  users         User[]
  applications  PurchaseApplication[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("departments")
}

model User {
  id           String                @id @default(uuid()) @db.Char(36)
  tenantId     String                @map("tenant_id") @db.Char(36)
  departmentId String                @map("department_id") @db.Char(36)
  username     String                @db.VarChar(100)
  displayName  String                @map("display_name") @db.VarChar(100)
  role         UserRole
  status       EntityStatus          @default(ACTIVE)
  passwordHash String                @map("password_hash") @db.VarChar(255)
  version      Int                   @default(1)
  createdAt    DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onUpdate: Restrict)
  department   Department            @relation(fields: [tenantId, departmentId], references: [tenantId, id], onUpdate: Restrict)
  sessions     Session[]
  applications PurchaseApplication[]
  approvals    ApprovalRecord[]

  @@unique([tenantId, id])
  @@unique([tenantId, username])
  @@index([tenantId, departmentId, status])
  @@index([tenantId, role, status])
  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Char(36)
  tenantId  String    @map("tenant_id") @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user      User      @relation(fields: [tenantId, userId], references: [tenantId, id])

  @@index([tenantId, userId])
  @@index([revokedAt, expiresAt])
  @@map("sessions")
}

model PurchaseApplication {
  id                  String                    @id @default(uuid()) @db.Char(36)
  tenantId            String                    @map("tenant_id") @db.Char(36)
  applicationNo       String?                   @map("application_no") @db.VarChar(32)
  creatorId           String                    @map("creator_id") @db.Char(36)
  departmentId        String                    @map("department_id") @db.Char(36)
  title               String                    @db.VarChar(100)
  reason              String?                   @db.Text
  costCenter          String?                   @map("cost_center") @db.VarChar(100)
  currency            String                    @default("CNY") @db.Char(3)
  totalAmountCents    BigInt                    @default(0) @map("total_amount_cents")
  status              ApplicationStatus         @default(DRAFT)
  currentApprovalNode ApprovalNode?             @map("current_approval_node")
  submittedAt         DateTime?                 @map("submitted_at") @db.DateTime(3)
  decidedAt           DateTime?                 @map("decided_at") @db.DateTime(3)
  version             Int                       @default(1)
  createdAt           DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)
  tenant              Tenant                    @relation(fields: [tenantId], references: [id])
  creator             User                      @relation(fields: [tenantId, creatorId], references: [tenantId, id])
  department          Department                @relation(fields: [tenantId, departmentId], references: [tenantId, id])
  items               PurchaseApplicationItem[]
  approvals           ApprovalRecord[]
  events              WorkflowEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, applicationNo])
  @@index([tenantId, creatorId, updatedAt])
  @@index([tenantId, departmentId, status, updatedAt])
  @@index([tenantId, status, updatedAt])
  @@map("purchase_applications")
}

model PurchaseApplicationItem {
  id              String              @id @default(uuid()) @db.Char(36)
  tenantId        String              @map("tenant_id") @db.Char(36)
  applicationId   String              @map("application_id") @db.Char(36)
  lineNo          Int                 @map("line_no")
  name            String              @db.VarChar(200)
  quantity        Decimal             @db.Decimal(16, 4)
  unitPriceCents  BigInt              @map("unit_price_cents")
  lineAmountCents BigInt              @map("line_amount_cents")
  note            String?             @db.VarChar(500)
  createdAt       DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  application     PurchaseApplication @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([applicationId, lineNo])
  @@index([tenantId, applicationId])
  @@map("purchase_application_items")
}

model ApprovalRecord {
  id            String              @id @default(uuid()) @db.Char(36)
  tenantId      String              @map("tenant_id") @db.Char(36)
  applicationId String              @map("application_id") @db.Char(36)
  node          ApprovalNode
  action        ApprovalAction
  approverId    String              @map("approver_id") @db.Char(36)
  comment       String?             @db.VarChar(500)
  fromStatus    ApplicationStatus   @map("from_status")
  toStatus      ApplicationStatus   @map("to_status")
  createdAt     DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  application   PurchaseApplication @relation(fields: [tenantId, applicationId], references: [tenantId, id])
  approver      User                @relation(fields: [tenantId, approverId], references: [tenantId, id])

  @@unique([applicationId, node])
  @@index([tenantId, approverId, createdAt])
  @@map("approval_records")
}

model WorkflowEvent {
  id            String              @id @default(uuid()) @db.Char(36)
  tenantId      String              @map("tenant_id") @db.Char(36)
  applicationId String              @map("application_id") @db.Char(36)
  eventType     String              @map("event_type") @db.VarChar(64)
  actorId       String              @map("actor_id") @db.Char(36)
  fromStatus    ApplicationStatus?  @map("from_status")
  toStatus      ApplicationStatus   @map("to_status")
  createdAt     DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  application   PurchaseApplication @relation(fields: [tenantId, applicationId], references: [tenantId, id])

  @@unique([applicationId, eventType])
  @@map("workflow_events")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Char(36)
  tenantId       String   @map("tenant_id") @db.Char(36)
  actorId        String   @map("actor_id") @db.Char(36)
  operation      String   @db.VarChar(64)
  key            String   @db.VarChar(64)
  requestHash    String   @map("request_hash") @db.Char(64)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  resourceId     String?  @map("resource_id") @db.Char(36)
  expiresAt      DateTime @map("expires_at") @db.DateTime(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([tenantId, actorId, operation, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model AuditLog {
  id            String      @id @default(uuid()) @db.Char(36)
  tenantId      String      @map("tenant_id") @db.Char(36)
  eventType     String      @map("event_type") @db.VarChar(64)
  actorId       String?     @map("actor_id") @db.Char(36)
  targetType    String      @map("target_type") @db.VarChar(64)
  targetId      String?     @map("target_id") @db.Char(36)
  result        AuditResult
  requestId     String      @map("request_id") @db.Char(36)
  ipHash        String?     @map("ip_hash") @db.Char(64)
  changeSummary Json?       @map("change_summary")
  createdAt     DateTime    @default(now()) @map("created_at") @db.DateTime(3)

  @@index([tenantId, createdAt, id])
  @@index([tenantId, eventType, createdAt])
  @@index([tenantId, actorId, createdAt])
  @@map("audit_logs")
}

model TenantSequence {
  tenantId     String   @map("tenant_id") @db.Char(36)
  sequenceDate DateTime @map("sequence_date") @db.Date
  nextValue    Int      @map("next_value")

  @@id([tenantId, sequenceDate])
  @@map("tenant_sequences")
}
